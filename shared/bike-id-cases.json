{
  "_comment": "網頁 (parseBikeId.ts) 與 Android (BikeIdParser.kt) 共用的車號解析測試案例。box = [left, top, right, bottom]，座標以像素為單位。",
  "layout": [2, 5],
  "cases": [
    {
      "name": "標準上 2 下 5",
      "lines": [
        { "text": "12", "box": [40, 10, 80, 40] },
        { "text": "34567", "box": [10, 50, 110, 80] }
      ],
      "expect": "1234567"
    },
    {
      "name": "輸入順序顛倒仍依座標判斷",
      "lines": [
        { "text": "34567", "box": [10, 50, 110, 80] },
        { "text": "12", "box": [40, 10, 80, 40] }
      ],
      "expect": "1234567"
    },
    {
      "name": "有雜訊文字",
      "lines": [
        { "text": "YouBike 2.0", "box": [0, 0, 150, 8] },
        { "text": "12", "box": [40, 10, 80, 40] },
        { "text": "34567", "box": [10, 50, 110, 80] },
        { "text": "0800-000-000", "box": [0, 100, 150, 115] }
      ],
      "expect": "1234567"
    },
    {
      "name": "字元誤認校正 I→1、S→5、O→0",
      "lines": [
        { "text": "I2", "box": [40, 10, 80, 40] },
        { "text": "34S6O", "box": [10, 50, 110, 80] }
      ],
      "expect": "1234560"
    },
    {
      "name": "兩行被黏成單行 7 碼",
      "lines": [{ "text": "12 34567", "box": [10, 10, 110, 80] }],
      "expect": "1234567"
    },
    {
      "name": "上 5 下 2 不符合格式",
      "lines": [
        { "text": "34567", "box": [10, 10, 110, 40] },
        { "text": "12", "box": [40, 50, 80, 80] }
      ],
      "expect": null
    },
    {
      "name": "左右不重疊的兩行不配對",
      "lines": [
        { "text": "12", "box": [300, 10, 340, 40] },
        { "text": "34567", "box": [10, 50, 110, 80] }
      ],
      "expect": null
    },
    {
      "name": "上下距離太遠不配對",
      "lines": [
        { "text": "12", "box": [40, 10, 80, 40] },
        { "text": "34567", "box": [10, 300, 110, 330] }
      ],
      "expect": null
    },
    {
      "name": "多組候選時選最近的配對",
      "lines": [
        { "text": "98", "box": [40, 0, 80, 20] },
        { "text": "12", "box": [40, 40, 80, 70] },
        { "text": "34567", "box": [10, 75, 110, 105] }
      ],
      "expect": "1234567"
    }
  ]
}
